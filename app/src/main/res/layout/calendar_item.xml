<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pancake.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_marginEnd="7dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <!-- Горизонтальный LinearLayout для Названия товара и Количества -->
    <TextView
        android:id="@+id/taskName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hint_task_name"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Pancake.CardTitle"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Тип товара -->
    <TextView
        android:id="@+id/importanceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hint_importance"
        android:textAppearance="@style/TextAppearance.Pancake.CardBody"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/taskName" />

    <TextView
        android:id="@+id/slaType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/date_label"
        android:textAppearance="@style/TextAppearance.Pancake.CardBody"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/importanceType" />

    <TextView
        android:id="@+id/recurrenceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/hint_recurrence"
        android:textAppearance="@style/TextAppearance.Pancake.CardBody"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slaType" />


    <TextView
        android:id="@+id/deadlineType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/select_date"
        android:textAppearance="@style/TextAppearance.Pancake.CardBody"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recurrenceType" />


    <!-- Кнопка удаления, по центру справа -->
    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_action"
        android:padding="8dp"
        android:src="@drawable/delete_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Время и Создано, в правом нижнем углу -->
    <LinearLayout
        android:id="@+id/infoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recurrenceType">

        <TextView
            android:id="@+id/itemCreatedBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/created_by_label"
            android:textAppearance="@style/TextAppearance.Pancake.CardMeta"
            android:textColor="?attr/colorOnSurfaceVariant"
            />

        <TextView
            android:id="@+id/itemTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/time_label"
            android:textAppearance="@style/TextAppearance.Pancake.CardMeta"
            android:textColor="?attr/colorOnSurfaceVariant"
            />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
