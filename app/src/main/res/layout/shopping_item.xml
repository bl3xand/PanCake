<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Pancake.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <!-- Горизонтальный LinearLayout для Названия товара и Количества -->
    <LinearLayout
        android:id="@+id/nameAndCountLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Название товара -->
        <TextView
            android:id="@+id/itemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_item_name"
            android:textAppearance="@style/TextAppearance.Pancake.CardTitle"
            android:textColor="?attr/colorOnSurface"
            />

        <!-- Количество товара -->
        <TextView
            android:id="@+id/itemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_item_count"
            android:textAppearance="@style/TextAppearance.Pancake.CardTitle"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Тип товара -->
    <TextView
        android:id="@+id/itemType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_item_type"
        android:textAppearance="@style/TextAppearance.Pancake.CardBody"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nameAndCountLayout" />

    <!-- Кнопка удаления, по центру справа -->
    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_action"
        android:padding="8dp"
        android:src="@drawable/delete_icon"
        app:layout_constraintBottom_toTopOf="@id/infoLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Время и Создано, в правом нижнем углу -->
    <LinearLayout
        android:id="@+id/infoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemType">

        <TextView
            android:id="@+id/itemCreatedBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/created_by_label"
            android:textAppearance="@style/TextAppearance.Pancake.CardMeta"
            android:textColor="?attr/colorOnSurfaceVariant"
            />

        <TextView
            android:id="@+id/itemTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/time_label"
            android:textAppearance="@style/TextAppearance.Pancake.CardMeta"
            android:textColor="?attr/colorOnSurfaceVariant"
            />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
