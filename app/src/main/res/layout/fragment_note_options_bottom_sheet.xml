                </FrameLayout>

                <FrameLayout
                    android:id="@+id/fNote7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp">

                    <View
                        android:layout_width="28dp"
