# Copy this file to secrets.properties and fill with your real values.
# Do not commit secrets.properties to git.

# GitHub Image Sync
github.token=your_github_token_here
github.owner=your-github-user-or-org
github.repo=your-repo-name
github.branch=main

# Kinopoisk API
kinopoisk.apiKey=your_kinopoisk_api_key

# Release signing
RELEASE_STORE_FILE=/absolute/path/to/your-release.keystore
RELEASE_STORE_PASSWORD=your_store_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password

